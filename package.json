{
  "name": "secure-messenger-security-testing",
  "version": "1.0.0",
  "description": "Security testing framework for Secure Messenger",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:crypto": "vitest run --include='**/crypto/**'",
    "test:protocol": "vitest run --include='**/protocol/**'",
    "test:security": "vitest run --include='**/security/**'",
    "test:penetration": "vitest run --include='**/pentest/**'",
    "test:fuzzing": "vitest run --include='**/fuzz/**'",
    "test:e2e": "vitest run --include='**/e2e/**'",
    "test:coverage": "vitest run --coverage",
    "audit:dependencies": "npm audit --json > reports/audit.json",
    "audit:static": "eslint src --format json > reports/static-analysis.json || true"
  },
  "dependencies": {
    "crypto": "^1.0.1",
    "tweetnacl": "^1.1.3",
    "tweetnacl-util": "^0.1.4"
  },
  "devDependencies": {
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4",
    "fast-check": "^3.14.0"
  }
}
