{
  "name": "secure-messenger-backend",
  "version": "1.0.0",
  "description": "Production-grade backend for end-to-end encrypted messaging",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "echo 'No build step needed'",
    "test": "vitest",
    "test:integration": "vitest run --include '**/*.integration.test.js'",
    "test:security": "vitest run --include '**/*.security.test.js'",
    "migrate": "node src/db/migrate.js",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.js'"
  },
  "keywords": [
    "security",
    "messaging",
    "encryption",
    "e2ee",
    "backend"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.8.1",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "jsonwebtoken": "^9.1.2",
    "bcryptjs": "^2.4.3",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "winston": "^3.11.0",
    "prom-client": "^15.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "vitest": "^1.0.4",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  }
}
